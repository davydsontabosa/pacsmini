# ─────────────────────────────────────────────────────────────────────────────
# PACS Mini — Variáveis de ambiente (MVP / integração com dcm4chee existente)
# Copie para .env e ajuste os valores obrigatórios antes de subir os containers.
# ─────────────────────────────────────────────────────────────────────────────

# ── OBRIGATÓRIO ───────────────────────────────────────────────────────────────

# Segredo de API — use: openssl rand -hex 32
API_SECRET=troque-por-uma-string-secreta-de-32-caracteres-minimo

# URL interna do dcm4chee acessível pelo container pacs-server.
# Se dcm4chee roda no host Linux (sem Docker):  http://host.docker.internal:8080
# Se dcm4chee roda em outro container na mesma rede: http://<container-name>:8080
DCM4CHEE_BASE_URL=http://host.docker.internal:8080

# ── dcm4chee ─────────────────────────────────────────────────────────────────

# AE Title do dcm4chee (padrão de instalação padrão)
DCM4CHEE_AET=DCM4CHEE

# Host e porta PÚBLICOS do dcm4chee — usados pelo browser para carregar thumbnails
# (pode ser o IP do servidor Linux ou um hostname DNS)
DCM4CHEE_PUBLIC_HOST=192.168.1.100
DCM4CHEE_PUBLIC_PORT=8080

# ── URLs públicas ─────────────────────────────────────────────────────────────

# URL pública do frontend (sem barra no final)
FRONTEND_URL=http://192.168.1.100

# URL base para links de compartilhamento enviados por e-mail
SHARE_BASE_URL=http://192.168.1.100

# ── Portas dos serviços ───────────────────────────────────────────────────────

WEB_PORT=80
SERVER_PORT=3500

# ── E-mail (opcional) ─────────────────────────────────────────────────────────
# Sem configuração, notificações e links de compartilhamento não são enviados.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=pacs@seudominio.com
EMAIL_ALERT_TO=admin@seudominio.com

# ── Monitoramento de disco (opcional) ─────────────────────────────────────────

# Caminho do storage do dcm4chee no HOST (montado como :ro no container)
DCM4CHEE_STORAGE_PATH=/var/lib/dcm4chee/storage

DISK_WARN_PERCENT=80
DISK_CRITICAL_PERCENT=90
DISK_CHECK_CRON=0 * * * *
DISK_COOLDOWN_HOURS=4

# ── Personalização ────────────────────────────────────────────────────────────

APP_NAME=PACS Mini
