# ═══════════════════════════════════════════════════════════════════════════════
# PACS Mini — Environment Variables (Root)
# Copie para .env e preencha antes de iniciar:   cp .env.example .env
# NUNCA comite o .env no repositório!
# ═══════════════════════════════════════════════════════════════════════════════

# ── Segurança ──────────────────────────────────────────────────────────────────
# Segredo da API — mínimo 32 caracteres
# Gere com: openssl rand -hex 32
API_SECRET=SUBSTITUA_POR_VALOR_SEGURO_MINIMO_32_CHARS

# ── URLs Públicas ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://seu-servidor.com
SERVER_PUBLIC_URL=http://seu-servidor.com:3500
SHARE_BASE_URL=http://seu-servidor.com

# ── PostgreSQL (dcm4chee) ──────────────────────────────────────────────────────
POSTGRES_DB=pacsdb
POSTGRES_USER=pacs
# Gere com: openssl rand -hex 20
POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_FORTE

# ── dcm4chee Archive ──────────────────────────────────────────────────────────
DCM4CHEE_PUBLIC_HOST=seu-servidor.com
DCM4CHEE_AET=DCM4CHEE
ARC_HTTP_PORT=8080
DICOM_PORT=11112

# ── Portas ────────────────────────────────────────────────────────────────────
SERVER_PORT=3500
WEB_PORT=80

# ── SMTP / Email ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua-app-password
EMAIL_FROM="PACS Mini <seuemail@gmail.com>"
EMAIL_ALERT_TO=admin@clinica.com,ti@clinica.com

# ── Alertas de disco ──────────────────────────────────────────────────────────
DISK_WARN_PERCENT=80
DISK_CRITICAL_PERCENT=90

# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=PACS Mini
