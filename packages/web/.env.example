# ─────────────────────────────────────────────────────────────────────────────
# PACS Mini Web — Variáveis de Ambiente (Vite)
# Copie para .env:   cp .env.example .env
# NOTA: Em produção Docker, estas variáveis são injetadas via build args.
# ─────────────────────────────────────────────────────────────────────────────

# ── dcm4chee Archive ──────────────────────────────────────────────────────────
# IP/hostname do servidor dcm4chee (acessível pelo navegador)
VITE_DCM4CHEE_HOST=localhost
VITE_DCM4CHEE_PORT=8080
VITE_DCM4CHEE_AET=DCM4CHEE

# ── Backend PACS Mini ─────────────────────────────────────────────────────────
VITE_SERVER_URL=http://localhost:3500
# Deve ser igual ao API_SECRET do server
VITE_API_SECRET=mude-esta-chave-secreta-minimo-32-chars-obrigatorio

# ── App ────────────────────────────────────────────────────────────────────────
VITE_APP_NAME="PACS Mini"
