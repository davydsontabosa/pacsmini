# ─────────────────────────────────────────────────────────────────────────────
# PACS Mini Server — Variáveis de Ambiente
# Copie para .env e configure:   cp .env.example .env
# NUNCA comite o .env no repositório!
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ───────────────────────────────────────────────────────────────────
PORT=3500
NODE_ENV=development

# Segredo da API — OBRIGATÓRIO em produção (mínimo 32 caracteres)
# Gere com: openssl rand -hex 32
API_SECRET=mude-esta-chave-secreta-minimo-32-chars-obrigatorio

# URL do frontend (para CORS em produção)
FRONTEND_URL=http://localhost:5173

# ── dcm4chee Archive 5 ────────────────────────────────────────────────────────
DCM4CHEE_BASE_URL=http://localhost:8080
DCM4CHEE_AET=DCM4CHEE

# ── SMTP / Email ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seuemail@gmail.com
# Para Gmail: use App Password (https://myaccount.google.com/apppasswords)
SMTP_PASS=sua-app-password-aqui
EMAIL_FROM="PACS Mini <seuemail@gmail.com>"
# Múltiplos destinatários separados por vírgula
EMAIL_ALERT_TO=ti@clinica.com,admin@clinica.com

# ── Monitoramento de Disco ────────────────────────────────────────────────────
STORAGE_PATH=/storage
DISK_WARN_PERCENT=80
DISK_CRITICAL_PERCENT=90
# Cron expression para verificação (padrão: a cada hora)
DISK_CHECK_CRON=0 */1 * * *

# ── Compartilhamento de Exames ────────────────────────────────────────────────
# URL pública onde o frontend está acessível externamente
SHARE_BASE_URL=http://localhost:5173
# Tempo padrão de expiração de links (em horas)
SHARE_DEFAULT_EXPIRES_H=72
# Máximo de acessos por link (0 = ilimitado)
SHARE_MAX_ACCESSES=0

# ── Banco de dados SQLite ─────────────────────────────────────────────────────
DB_PATH=./data/pacs-mini.db
